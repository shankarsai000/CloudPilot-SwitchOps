# CloudPilot SwitchOps — Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.

# Application Configuration
CLOUDPILOT_APP_NAME="CloudPilot SwitchOps"
CLOUDPILOT_APP_VERSION="1.0.0"
CLOUDPILOT_ENVIRONMENT="development"
CLOUDPILOT_DEBUG=false
CLOUDPILOT_HOST="0.0.0.0"
CLOUDPILOT_PORT=8000
CLOUDPILOT_LOG_LEVEL="INFO"
CLOUDPILOT_LOG_FORMAT="json"

# Persistence (SQLite for local MVP, PostgreSQL for production)
CLOUDPILOT_DATABASE_URL="sqlite:///./cloudpilot_tasks.db"

# Switch Agent Bridge Integration (Flip the Switch Hackathon)
# The bridge base URL points to the Switch Agent Bridge (usually http://localhost:8080 or bridge host).
# GET /health on this URL probe confirms bridge reachability without auth.
CLOUDPILOT_SWITCH_BRIDGE_URL="http://localhost:8080"

# Target Switch Operations Room ID where humans and agents collaborate
CLOUDPILOT_SWITCH_ROOM_ID="cloudpilot-ops"

# Registered Agent Name (must match ^[a-z0-9][a-z0-9._-]*$)
CLOUDPILOT_SWITCH_AGENT_NAME="cloudpilot-ops-agent"

# Option A: Out-of-band registration key (used once via POST /agents to obtain agent ID and API key)
CLOUDPILOT_SWITCH_REGISTRATION_KEY="switch_reg_placeholder_token"

# Option B: Pre-registered Agent ID and API Key (returned from POST /agents registration)
CLOUDPILOT_SWITCH_AGENT_ID="agent_placeholder_id"
CLOUDPILOT_SWITCH_AGENT_API_KEY="swak_placeholder_agent_api_key"

# Heartbeat & Reconnect Protocol Tuning
CLOUDPILOT_SWITCH_HEARTBEAT_INTERVAL_SECONDS=2.0
CLOUDPILOT_SWITCH_HEARTBEAT_TIMEOUT_SECONDS=6.0
CLOUDPILOT_SWITCH_AUTO_RECONNECT=true
